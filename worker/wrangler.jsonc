{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kb-ai-trader",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": [
      "DASHBOARD_API_KEY",
      "KB_APP_KEY",
      "KB_APP_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "* 0-5 * * MON-FRI",
      "0-29 6 * * MON-FRI",
      "35 6 * * MON-FRI"
    ]
  }
}
